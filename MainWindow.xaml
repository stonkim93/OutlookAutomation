<Window x:Class="OutlookAutomationApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Outlook 파일 첨부 자동화"
        Width="700" Height="500"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        AllowDrop="True"
        Drop="Window_Drop">
    <Grid Margin="20">
        <!-- Spacing 속성 제거 -->
        <StackPanel Orientation="Vertical">
            
            <!-- 제목 -->
            <TextBlock Text="Outlook 파일 첨부 자동화"
                       FontSize="24" FontWeight="Bold"
                       Foreground="#333333"
                       Margin="0,0,0,20" />
            
            <!-- 파일 선택 -->
            <!-- Margin을 통해 Spacing 대체 -->
            <GroupBox Header="1단계: 파일 선택" Padding="15" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="TxtSourceFile" 
                            Width="500" Height="35"
                            VerticalContentAlignment="Center"
                            IsReadOnly="True"
                            Padding="10"
                            Background="White"
                            Text="파일을 선택하세요"
                            Margin="0,0,10,0" />
                    <Button x:Name="BtnSelectFile"
                           Content="파일 선택..."
                           Width="120" Height="35"
                           Click="BtnSelectFile_Click"
                           Background="#0078D4"
                           Foreground="White"
                           FontWeight="Bold" />
                </StackPanel>
            </GroupBox>
            
            <!-- 폴더 선택 -->
            <GroupBox Header="2단계: 출력 폴더 선택" Padding="15" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="TxtOutputFolder"
                            Width="500" Height="35"
                            VerticalContentAlignment="Center"
                            IsReadOnly="True"
                            Padding="10"
                            Background="White"
                            Text="폴더를 선택하세요"
                            Margin="0,0,10,0" />
                    <Button x:Name="BtnSelectFolder"
                           Content="폴더 선택..."
                           Width="120" Height="35"
                           Click="BtnSelectFolder_Click"
                           Background="#0078D4"
                           Foreground="White"
                           FontWeight="Bold" />
                </StackPanel>
            </GroupBox>
            
            <!-- 설명 -->
            <TextBlock Text="이 프로그램은 다음을 수행합니다:"
                      FontSize="12" FontWeight="Bold" Margin="0,0,0,5" />
            <TextBlock Text="1. 파일을 기본 앱으로 엽니다 (Excel, Word 등)"
                      FontSize="11" Margin="0,0,0,3" />
            <TextBlock Text="2. Outlook을 열고 파일을 첨부합니다"
                      FontSize="11" Margin="0,0,0,3" />
            <TextBlock Text="3. 첨부 파일을 지정된 폴더에 저장합니다"
                      FontSize="11" Margin="0,0,0,15" />
            
            <!-- 상태 -->
            <TextBlock x:Name="TextBlockStatus"
                      Text="준비 완료"
                      FontSize="12"
                      Foreground="Black"
                      Margin="0,0,0,5" />
            
            <!-- 진행 표시줄 -->
            <ProgressBar x:Name="ProgressBar"
                        Height="5"
                        IsIndeterminate="True"
                        Visibility="Hidden"
                        Margin="0,0,0,10" />
            
            <!-- 실행 버튼 -->
            <Button x:Name="BtnExecute"
                   Content="자동화 실행"
                   Height="45"
                   FontSize="14"
                   FontWeight="Bold"
                   Background="#107C10"
                   Foreground="White"
                   Click="BtnExecute_Click"
                   Cursor="Hand" />
        </StackPanel>
    </Grid>
</Window>